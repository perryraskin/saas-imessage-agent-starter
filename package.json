{
  "name": "saas-imessage-agent-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Production-minded iMessage agent starter for SaaS products",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:agent": "eve build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:channel": "eve eval --tag channel-e2e --strict",
    "eval:deployed": "node evals/deployed-canary.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm build:agent"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.100",
    "@posthog/mcp": "0.21.0",
    "@vercel/connect": "^2.3.4",
    "ai": "^7.0.122",
    "eve": "^0.68.0",
    "jose": "^6.2.12",
    "next": "^16.3.8",
    "posthog-node": "^5.54.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "workflow": "^5.0.0-beta.57",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
