# The zero-config simulator does not require environment variables.

# Required before enabling a real channel
IMESSAGE_ENABLED=false
SAAS_ADAPTER=demo
SAAS_APP_URL=http://localhost:3000
AGENT_INTERNAL_SECRET=replace-with-at-least-32-random-characters
IMESSAGE_EVENT_SEALING_KEY=replace-with-a-32-byte-base64url-key
IMESSAGE_LINQ_CONNECTOR=replace-with-your-vercel-connect-uid
IMESSAGE_LINQ_PARTNER_ID=replace-with-your-linq-partner-id

# Optional model override. Vercel deployments authenticate AI Gateway with OIDC.
EVE_MODEL=openai/gpt-5.6-luna

# Optional canonical MCP Analytics. Raw message and SaaS content are never sent.
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Optional deployed canary. Keep disabled and isolated from customer data by default.
CHANNEL_EVAL_ENABLED=false
CHANNEL_EVAL_SECRET=replace-with-at-least-32-random-characters
CHANNEL_EVAL_USER_ID=starter-eval-user
